include README.md
include LICENSE
include CHANGELOG.md
include RELEASE.md

include src/pandax/banner.txt
recursive-include src/pandax/templates *.sh pre-commit-hook pre-commit-check.py README.md

# Phase 9: OS 右键菜单集成（所有平台）
include installer/windows/*.ps1
recursive-include installer/macos *.sh
recursive-include installer/macos/PandaX Lock.workflow *.plist *.wflow
recursive-include installer/linux *.sh
include installer/linux/nautilus/PandaX
include installer/linux/dolphin/*.desktop
include installer/*.iss

# 文档资源
include assets/*.svg

# PyPI 元数据
include pyproject.toml