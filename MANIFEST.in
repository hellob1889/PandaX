include README.md
include LICENSE
include CHANGELOG.md
include RELEASE.md

include src/pandax/banner.txt
recursive-include src/pandax/templates *.sh pre-commit-hook pre-commit-check.py README.md

# Phase 9: OS 右键菜单集成（所有平台，v0.7.1+ installer 移入 src/pandax/）
recursive-include src/pandax/installer/windows *.ps1
recursive-include src/pandax/installer/macos *.sh
recursive-include src/pandax/installer/macos/PandaX Lock.workflow *.plist *.wflow
recursive-include src/pandax/installer/linux *.sh
include src/pandax/installer/linux/nautilus/PandaX
include src/pandax/installer/linux/dolphin/*.desktop
include src/pandax/installer/*.iss

# 文档资源
include assets/*.svg

# PyPI 元数据
include pyproject.toml