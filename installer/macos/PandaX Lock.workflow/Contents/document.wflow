				<key>ActionBundlePath</key>
				<string>/usr/bin/automator_runner</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
				<string># {TXT_COMMENT_INPUT}
# {TXT_COMMENT_STDIN}
INPUT_PATHS=$(cat)
if [ -z "$INPUT_PATHS" ]; then
  osascript -e 'display alert "PandaX" message "{TXT_NO_SELECTION}" as warning'
  exit 1
fi

# {TXT_COMMENT_PICK_FIRST}
TARGET=$(echo "$INPUT_PATHS" | head -1)

# {TXT_COMMENT_PARENT_DIR}
if [ -f "$TARGET" ]; then
  TARGET_DIR=$(dirname "$TARGET")
else
  TARGET_DIR="$TARGET"
fi

# {TXT_COMMENT_MENU_HEADER}
CHOICE=$(osascript -e "choose from list {\"init\", \"lock\", \"unlock\", \"status\"} with title \"PandaX\" with prompt \"{TXT_MENU_PROMPT}:$TARGET_DIR\" default items {\"lock\"}")

if [ -z "$CHOICE" ]; then
  exit 0  # {TXT_COMMENT_CANCELLED}
fi

# {TXT_COMMENT_TERMINAL}
osascript <<EOF
tell application "Terminal"
    activate
    do script "cd '$TARGET_DIR' && pandax --silent --trust-default $CHOICE --root '$TARGET_DIR'; echo ''; echo '--- {TXT_PRESS_ANY_KEY} ---'; read -n 1"
end tell
EOF</string>
					<key>CheckedForUserDefaultShell</key>
					<integer>1</integer>
					<key>DISPLAY_NAME</key>
					<string>Run Shell Script</string>
					<key>inputMethod</key>
